# SQLite database path
DB_PATH=data/agent.db

# Account being monitored
ACCOUNT=realDonaldTrump
ACCOUNT_ID=107780257626128497

# Which PostSource implementation to use: truthsocial_api | trumpstruth_rss | fixture
SOURCE=truthsocial_api

# Polling cadence
POLL_INTERVAL_SECONDS=30
QUIET_POLL_INTERVAL_SECONDS=60

# curl_cffi TLS impersonation profile used against truthsocial.com
IMPERSONATE=safari17_0
REQUEST_TIMEOUT=20

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/agent.jsonl

# Primary remote channel. Server Settings, Integrations, New Webhook, Copy URL.
# The URL is the whole credential, so treat it like a password.
DISCORD_WEBHOOK_URL=
# Always on. Every alert is appended here as JSONL, no setup needed.
ALERTS_FILE=data/alerts.jsonl

# Optional second remote channel. Run scripts/setup_telegram.py to fill in the
# chat id once you have messaged your bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Groq. Enables the LLM detector arm and sentiment scoring.
GROQ_API_KEY=
GROQ_MODEL=

# Health thresholds
HEARTBEAT_STALE_MINUTES=15
NO_POSTS_ALARM_HOURS=12
# Nothing older than this alerts on a live source, whatever the store says.
# Backstop against a database that predates backfill marking its own rows.
MAX_ALERT_AGE_HOURS=24
